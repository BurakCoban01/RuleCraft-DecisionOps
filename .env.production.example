# Copy to a protected operator-owned environment file. Never commit real values.
RULECRAFT_BUILD_VERSION=0.1.0-local
RULECRAFT_BIND_ADDRESS=127.0.0.1
RULECRAFT_WEB_PORT=50113
RULECRAFT_DB_NAME=rulecraft
RULECRAFT_DB_USER=rulecraft
RULECRAFT_DB_PASSWORD=replace-with-at-least-32-random-characters
RULECRAFT_DB_POOL_SIZE=8
RULECRAFT_SESSION_COOKIE_SECURE=true

# Enable only for the first controlled start, then set false and remove the password.
RULECRAFT_BOOTSTRAP_ENABLED=false
RULECRAFT_BOOTSTRAP_WORKSPACE=acme-rules
RULECRAFT_BOOTSTRAP_TENANT_NAME=Acme Rules
RULECRAFT_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
RULECRAFT_BOOTSTRAP_ADMIN_NAME=Ada Admin
RULECRAFT_BOOTSTRAP_ADMIN_PASSWORD=
