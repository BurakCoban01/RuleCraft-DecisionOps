# Copy to .env for local Docker Compose use. Do not reuse these values outside a private local workstation.
RULECRAFT_DB_NAME=rulecraft
RULECRAFT_DB_USER=rulecraft
RULECRAFT_DB_PASSWORD=replace-with-a-local-secret
RULECRAFT_DB_PORT=50112

# Enable only for first-run local workspace administration, then disable after the account exists.
RULECRAFT_BOOTSTRAP_ENABLED=false
RULECRAFT_BOOTSTRAP_WORKSPACE=acme-rules
RULECRAFT_BOOTSTRAP_TENANT_NAME=Acme Rules
RULECRAFT_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
RULECRAFT_BOOTSTRAP_ADMIN_NAME=Ada Admin
RULECRAFT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
